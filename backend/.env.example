# ============================================================
# CONFIGURACIÓN DE ENTORNO — Plataforma de Hospedaje
# ============================================================
# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env a control de versiones.
# ============================================================

# === Base de Datos (MySQL) ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospedaje_db
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui

# === Base de Datos de Tests ===
DB_TEST_NAME=hospedaje_db_test

# === JSON Web Token ===
JWT_SECRET=cambiar_por_un_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1h
JWT_RESET_EXPIRES_IN=15m

# === Email (SendGrid / Nodemailer) ===
SENDGRID_API_KEY=tu_api_key_de_sendgrid_aqui
EMAIL_FROM=noreply@hospedaje.com

# === Servidor ===
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
